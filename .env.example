# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DB_NAME=gamecock_breeding_db
DB_USER=gamecock_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Persistent DB connections (seconds). 0 = close every request (Django default).
DB_CONN_MAX_AGE=60

# --- JWT (SimpleJWT) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- API throttling (DRF), requests per window ---
THROTTLE_RATE_ANON=30/min
THROTTLE_RATE_USER=120/min
THROTTLE_RATE_LOGIN=10/min
THROTTLE_RATE_REGISTER=10/min
THROTTLE_RATE_PASSWORD_RESET=5/min
THROTTLE_RATE_LINE_WEBHOOK=120/min

# --- Production security hardening (STEP10) ---
# All default to the opposite of DJANGO_DEBUG (i.e. "on" once DJANGO_DEBUG=False),
# so leave these blank/unset for normal local dev and production deployments alike;
# only set explicitly to override a default (e.g. TLS terminated by a reverse proxy).
DJANGO_SECURE_SSL_REDIRECT=
DJANGO_SESSION_COOKIE_SECURE=
DJANGO_CSRF_COOKIE_SECURE=
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_SECURE_HSTS_SECONDS=
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=
DJANGO_SECURE_HSTS_PRELOAD=

# --- Business identity (shown on generated PDF documents) ---
FARM_NAME=ฟาร์มไก่ชนตัวอย่าง

# --- LINE Notification (integrated in a later step, keep placeholders now) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Email (password reset). Leave blank to use the console backend in DEBUG mode ---
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@gamecock-breeding.local
PASSWORD_RESET_TIMEOUT_SECONDS=3600
