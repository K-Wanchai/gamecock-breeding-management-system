# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DB_NAME=gamecock_breeding_db
DB_USER=gamecock_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- JWT (SimpleJWT) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Business identity (shown on generated PDF documents) ---
FARM_NAME=ฟาร์มไก่ชนตัวอย่าง

# --- LINE Notification (integrated in a later step, keep placeholders now) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Email (password reset). Leave blank to use the console backend in DEBUG mode ---
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@gamecock-breeding.local
PASSWORD_RESET_TIMEOUT_SECONDS=3600
